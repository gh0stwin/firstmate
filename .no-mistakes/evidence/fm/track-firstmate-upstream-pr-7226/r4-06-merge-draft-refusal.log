$ FM_HOME=$LAB PATH=$LAB/fakebin:$PATH bin/fm-pr-merge.sh live-b1m https://gitlab.com/gh0stwin/firstmate-t4-b-641207/-/merge_requests/1 --allow-no-pipeline
exit=1
