# gl-stale: the worker committed again AFTER its merge request merged - work that exists nowhere else
# each watch is armed through the real fm-pr-check.sh (no-mistakes mode: the forge-reported head is the named head)
$ fm-pr-check.sh gl-landed https://gitlab.com/gh0stwin/firstmate-gitlab-port-fixture/-/merge_requests/1
