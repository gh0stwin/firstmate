# === three ship tasks whose commits sit on NO remote-tracking ref, so teardown must ask the forge ===
# the project clone tracks only main - as a no-mistakes worker's clone does, where the pipeline (not the
# worker) pushes the branch - so the only thing that can prove the work landed is the merge request itself
$ git clone -q --single-branch --branch main https://gitlab.com/gh0stwin/firstmate-gitlab-port-fixture.git /tmp/fm-lab.zaEFbL/projects/fixture-td
[exit 0]

$ glab mr view 1 -R https://gitlab.com/gh0stwin/firstmate-gitlab-port-fixture -F json | jq -c '{iid,state,sha,source_branch,merge_commit_sha,squash_commit_sha}'
