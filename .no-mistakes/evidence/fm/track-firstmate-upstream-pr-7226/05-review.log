$ git clone -q --branch fm/gl-arm --single-branch https://gitlab.com/gh0stwin/firstmate-gitlab-port-fixture.git scratch/fixround
[exit 0]

$ git -C scratch/fixround commit -q -am fixture: fix round advances the merge request head
[exit 0]

$ git -C scratch/fixround push -q -o ci.skip origin fm/gl-arm
